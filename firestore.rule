rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requesting user is listed in the 'admins' collection
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Rules for the 'pendaftaran' collection
    match /pendaftaran/{documentId} {
      // Anyone can submit a registration form (public write)
      allow create: if true;

      // Only verified admins can view, search, or delete registrations
      allow read, update, delete: if isAdmin();
    }

    // Rules for the 'admins' collection
    match /admins/{adminId} {
      // Users can check their own admin document to verify access upon login
      allow read: if request.auth != null && request.auth.uid == adminId;

      // Block all client-side writes to prevent unauthorized admin creation
      allow write: if false;
    }
  }
}